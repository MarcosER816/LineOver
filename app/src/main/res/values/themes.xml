<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; all UI is Compose and styled by LineOverTheme. -->
    <style name="Theme.LineOver" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lo_bg</item>
        <item name="android:windowSplashScreenBackground">@color/lo_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Launch theme (SplashScreen API): icon on the background colour, then Theme.LineOver. -->
    <style name="Theme.LineOver.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lo_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LineOver</item>
    </style>
</resources>
